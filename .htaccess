# Judes CBO website (Apache / cPanel). GitHub Pages ignores this file.
Options -Indexes
DirectoryIndex index.html index.php

# Friendly error pages
ErrorDocument 400 /400.html
ErrorDocument 401 /401.html
ErrorDocument 403 /403.html
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html
ErrorDocument 502 /502.html
ErrorDocument 503 /503.html

RewriteEngine On

# BEGIN force https (managed by the dashboard, do not edit)
# (off)
# END force https

# Hidden files and folders (.git, .env and the like) are never served; .well-known stays reachable
RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]

# BEGIN maintenance mode (managed by the dashboard, do not edit)
# (off)
# END maintenance mode

# Clean URLs: /about serves about.html, and old /about.html links redirect to /about
# (GET only so form posts are never redirected; the staff dashboard has its own rules)
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{REQUEST_URI} !/admin/
RewriteCond %{THE_REQUEST} \s([^\s?]*?/)index\.html[\s?]
RewriteRule ^ %1 [R=301,L,NE]
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{REQUEST_URI} !/admin/
RewriteCond %{THE_REQUEST} \s([^\s?]+?)\.html[\s?]
RewriteRule ^ %1 [R=301,L,NE]
# /about/ (trailing slash) -> /about, so relative links to styles and images keep working
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{THE_REQUEST} ^(?:GET|HEAD)\s([^\s?]+?)/[\s?]
RewriteRule ^(.+)/$ %1 [R=301,L,NE]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)$ $1.html [L]

# HTTPS: switch on "Force HTTPS" on the dashboard's Security page once the SSL certificate works

# Notes, database dumps, logs, backups and archives are never served
<FilesMatch "\.(md|sql|log|bak|old|orig|save|swp|ini|lock|env|sh|zip|tar|gz|tgz|7z|rar)$|^(composer\.(json|lock)|package(-lock)?\.json)$">
    Require all denied
</FilesMatch>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType image/webp .webp
</IfModule>

# The service worker must always be re-checked so updates reach visitors
<Files "sw.js">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache"
    </IfModule>
</Files>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/manifest+json text/xml application/xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 hour"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
</IfModule>

# Browser security headers for the public pages (the dashboard sends its own)
SetEnvIf Request_URI "/admin/" JUDES_ADMIN
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff" env=!JUDES_ADMIN
    Header always set Referrer-Policy "strict-origin-when-cross-origin" env=!JUDES_ADMIN
    Header always set X-Frame-Options "SAMEORIGIN" env=!JUDES_ADMIN
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" env=!JUDES_ADMIN
    # Scripts only from this site and cdnjs, forms only to this site and Formspree, maps and videos from Google/YouTube
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' data: https://cdnjs.cloudflare.com https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://formspree.io; frame-src https://maps.google.com https://www.google.com https://www.youtube.com https://www.youtube-nocookie.com; form-action 'self' https://formspree.io; frame-ancestors 'self'; base-uri 'self'; object-src 'none'" env=!JUDES_ADMIN
</IfModule>
